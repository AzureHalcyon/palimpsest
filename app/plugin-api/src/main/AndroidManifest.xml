<?xml version="1.0" encoding="utf-8"?>
<!--
  契约库的 manifest —— 它只声明**那一条签名级权限**。

  ★ 为什么是 signature 级：
    插件把自己暴露给"任何 App"是危险的（谁都能读你的传感器/日历）。
    用自定义签名级权限 ⇒ **只有同一签名（我们自己装的）的 App 才绑得上**。
    本体侧要写 <uses-permission>，插件侧在 <service android:permission=...> 上卡住。

  ★ 定义放在契约库里，本体和插件都会 merge 到自己的 APK ⇒ 权限定义只有一份来源。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.azurehalcyon.palimpsest.permission.PLUGIN"
        android:protectionLevel="signature"
        android:label="Companion 插件访问权" />

</manifest>
